<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="SalesShipmentType" strict="true">
        <property name="idSalesShipmentType" type="int"/>
        <property name="key" type="string"/>
        <property name="name" type="string"/>
    </transfer>

    <transfer name="SalesShipmentTypeCriteria" strict="true">
        <property name="salesShipmentTypeConditions" type="SalesShipmentTypeConditions"/>
    </transfer>

    <transfer name="SalesShipmentTypeConditions" strict="true">
        <property name="salesOrderItemIds" type="int[]" singular="salesOrderItemId"/>
    </transfer>

    <transfer name="ShipmentType" strict="true">
        <property name="idShipmentType" type="int"/>
        <property name="name" type="string"/>
        <property name="key" type="string"/>
    </transfer>

    <transfer name="SaveOrder">
        <property name="orderItems" type="Item[]" singular="orderItem"/>
    </transfer>

    <transfer name="Item">
        <property name="idSalesOrderItem" type="int"/>
        <property name="sku" type="string"/>
        <property name="quantity" type="int"/>
        <property name="shipmentType" type="ShipmentType" strict="true"/>
        <property name="shipment" type="Shipment"/>
    </transfer>

    <transfer name="CartReorder" strict="true">
        <property name="orderItems" type="Item[]" singular="orderItem"/>
        <property name="reorderItems" type="Item[]" singular="reorderItem"/>
    </transfer>

    <transfer name="Quote">
    </transfer>

    <transfer name="Shipment">
        <property name="idSalesShipment" type="int"/>
    </transfer>

</transfers>
